# Neon Postgres connection string used by app/api/waitlist/route.ts.
# Run db/schema.sql against this database once before the waitlist form will work.
DATABASE_URL=

# Canonical production URL, used by app/sitemap.ts, app/robots.ts, and metadataBase.
# Falls back to https://cobaltanalytix.com if unset.
NEXT_PUBLIC_SITE_URL=

# The "Reach us" contact form (app/api/contact/route.ts) writes to the
# contact_submissions table on DATABASE_URL. No other config needed — read
# submissions from the Neon SQL editor.