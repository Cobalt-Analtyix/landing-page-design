# Neon Postgres connection string used by app/api/waitlist/route.ts.
# Run db/schema.sql against this database once before the waitlist form will work.
DATABASE_URL=

# Canonical production URL, used by app/sitemap.ts, app/robots.ts, and metadataBase.
# Falls back to https://cobaltanalytix.com if unset.
NEXT_PUBLIC_SITE_URL=

# The "Reach us" contact form (app/api/contact/route.ts) writes to the
# contact_submissions table on DATABASE_URL. No other config needed — read
# submissions from the Neon SQL editor.

# --- Public site details (read in lib/site.ts) ---
# Contact email shown on the site. Defaults to contact@cobaltanalytix.com if unset.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional. Each of these is hidden from the site when left empty.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Booking link for "Book a call" buttons. Defaults to the existing Calendly link if unset.
NEXT_PUBLIC_BOOKING_URL=
# Social profiles. A button only appears in the footer and contact page when its URL is set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
